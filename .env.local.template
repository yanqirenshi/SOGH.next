# GitHub に実際につないで確かめるスクリプト (npm run check:live・npm run check:updated-at) の設定。
# このファイルを、.env.local という名前で写して、値を入れる。
# .env.local は、git に入らない。(.gitignore に入れてある)
# 環境変数 CHECK_ENV_FILE に、別の設定ファイルのパスを入れると、.env.local の代わりに、そのファイルを読む。

# GitHub の個人用アクセストークン。
# 読むだけなので、読み取りの権限だけで足りる。
#   classic のトークンのとき: repo・read:org・read:project・read:user・user:email
GITHUB_TOKEN=

# 組織 (org) のクエリも確かめるときに入れる。(無ければ、そのクエリは飛ばす)
# 組織の login。
CHECK_ORG=
# CHECK_ORG のリポジトリの名前と、Issue の番号。
CHECK_REPO=
CHECK_ISSUE_NUMBER=
# CHECK_ORG の ProjectV2 の番号。
CHECK_PROJECT_NUMBER=
# チーム (Team) の node id。
CHECK_TEAM_ID=

# npm run check:updated-at で、updatedAt がどの変更で動くかを確かめる Issue。
# owner/repo#番号 の形で書く。(owner は、ユーザーでも組織でもよい。例: octocat/hello-world#1)
CHECK_UPDATED_AT_ISSUE=
